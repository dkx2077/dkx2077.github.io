{
  "name": "dkx2077-homepage",
  "version": "1.0.45",
  "description": "Personal academic homepage for Kaixin Deng",
  "author": "Kaixin Deng",
  "license": "MIT",
  "homepage": "https://www.dengkaixin.com",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkx2077/dkx2077.github.io.git"
  },
  "scripts": {
    "serve": "npm run build && python3 -m http.server 8000 --directory dist",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "lint": "eslint --ext .js,.mjs static/js scripts tests",
    "format": "prettier --write \"{scripts,tests}/**/*.mjs\" \"static/**/*.{js,css}\" templates/index.html package.json README.md"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "marked": "^12.0.0",
    "js-yaml": "^4.1.0"
  }
}
